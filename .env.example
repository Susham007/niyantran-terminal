# ─────────────────────────────────────────────────────────────────────────────
# Niyantran Terminal — environment
# Copy this file to `.env` for local `netlify dev`, and set the SAME keys in
# Netlify → Site settings → Environment variables for production.
# NEVER commit the real .env (it is gitignored). Rotate any key that leaks.
# ─────────────────────────────────────────────────────────────────────────────

# AI engine (free). At least one is required; both = automatic fallback.
# Groq  → https://console.groq.com/keys   (primary, fastest)
# Gemini→ https://aistudio.google.com/apikey (fallback, generous daily free tier)
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (sensible free defaults are built in)
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# Backend dashboard (/admin). Any long random string. If unset, /admin is locked.
ADMIN_TOKEN=

# Manual "Run now" from the dashboard dispatches the GitHub Actions workflow.
# Needs a fine-grained token with "Actions: write" on the repo, and the repo slug.
GITHUB_TOKEN=
GITHUB_REPO=your-username/niyantran-terminal

# Optional: free data.gov.in key (lifts the throttled public-key limits)
# https://data.gov.in/  → Sign in → APIs
DATA_GOV_KEY=
